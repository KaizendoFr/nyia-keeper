# Nyia Keeper Claude Assistant Configuration
# Professional configuration for the Claude AI assistant

# === ASSISTANT IDENTITY ===
ASSISTANT_NAME="claude"
ASSISTANT_CLI="claude"

# === DOCKER CONFIGURATION ===
BASE_IMAGE_NAME="nyiakeeper-claude"  # Base name without tag
DOCKERFILE_PATH="docker/claude"

# === DEV IMAGE SETTINGS ===
ALLOW_DEV_IMAGES="true"

# === PROJECT CONTEXT ===
CONTEXT_DIR_NAME=".nyiakeeper/claude"
CONFIG_DIR_NAME=".nyiakeeper/claude"


# === AUTHENTICATION ===
AUTH_METHOD="token_setup"  # claude setup-token (new method)
API_KEY_ENV=""             # No API key needed for Claude

# === RAG SETTINGS ===
# Embedding model for codebase search (requires Ollama on host)
# Options: nomic-embed-text (768d, fast), mxbai-embed-large (1024d, accurate)
# To use: nyia-claude --rag
# Install model: ollama pull nomic-embed-text
NYIA_RAG_MODEL="nomic-embed-text"

# === DISPLAY METADATA (Plan 35 — shown by `nyia list`) ===
ASSISTANT_DISPLAY_NAME="Claude"
ASSISTANT_FULL_NAME="Claude Code"
ASSISTANT_DESCRIPTION="Anthropic's agentic coding CLI for the terminal, powered by Claude models"
ASSISTANT_PROVIDER="Anthropic"
