#!/bin/bash

# Nyia Keeper OpenCode Configuration Example
# Copy this file to opencode.conf and customize as needed

# === ASSISTANT IDENTITY ===
ASSISTANT_NAME="opencode"
ASSISTANT_CLI="opencode"

# === DOCKER CONFIGURATION ===
BASE_IMAGE_NAME="nyiakeeper-opencode"
DOCKERFILE_PATH="docker/opencode"

# === DEV IMAGE SETTINGS ===
ALLOW_DEV_IMAGES="true"

# === PROJECT CONTEXT ===
CONTEXT_DIR_NAME=".nyiakeeper/opencode"
CONFIG_DIR_NAME=".nyiakeeper/opencode"

# === AUTHENTICATION ===
# For local models (Ollama), leave empty
# For cloud providers, set to specific API key variable
AUTH_METHOD="multi_provider"
API_KEY_ENV=""

# === OLLAMA INTEGRATION ===
# Your own providers/models go in ~/.config/nyiakeeper/opencode/opencode.json (never regenerated by Nyia);
# the generated config.json next to it is Nyia's — see docs/CONFIGURATION.md "OpenCode configuration".
# These keys cross into the container (global config only, validated on the host — see
# docs/CONFIGURATION.md "What crosses into the container"). An invalid value is dropped with a warning.
ENABLE_OLLAMA="true"          # false = never touch the generated OpenCode config for Ollama
OLLAMA_AUTO_SETUP="true"      # false = keep ~/.config/nyiakeeper/opencode/config.json as it is (no regeneration)
# OLLAMA_FILTER_TOOLS="true"  # false = include every detected model, not only tool-capable ones

# Where Ollama runs, as seen FROM INSIDE THE CONTAINER: host[:port], no scheme. Empty = auto-detect
# (OpenCode: localhost, then host.docker.internal; the RAG detector: host.docker.internal, 172.17.0.1, localhost). "localhost" only works with the default --network host;
# on Docker Desktop use host.docker.internal. A LAN host under network_egress_policy=restrict-local
# also needs an entry in network-allow.conf.
# OLLAMA_HOST=""
# OLLAMA_HOST="host.docker.internal:11434"   # Docker Desktop
# OLLAMA_HOST="gpu-box:11434"                # another machine (egress allowlist!)

# Default model for OpenCode when it is among the detected Ollama models (else the first detected one,
# with a warning). Empty = first detected.
# OLLAMA_DEFAULT_MODEL=""
# OLLAMA_DEFAULT_MODEL="qwen3:8b"

# === CLOUD PROVIDER EXAMPLES ===
# For OpenAI: set AUTH_METHOD="openai" and API_KEY_ENV="OPENAI_API_KEY"
# For Anthropic: set AUTH_METHOD="anthropic" and API_KEY_ENV="ANTHROPIC_API_KEY"

# === RAG SETTINGS ===
# Embedding model for codebase search (requires Ollama on host)
# Options: nomic-embed-text (768d, fast), mxbai-embed-large (1024d, accurate)
# To use: nyia-opencode --rag
# Install model: ollama pull nomic-embed-text
NYIA_RAG_MODEL="nomic-embed-text"


# === DISPLAY METADATA (Plan 35 — shown by `nyia list`) ===
ASSISTANT_DISPLAY_NAME="OpenCode"
ASSISTANT_FULL_NAME="OpenCode"
ASSISTANT_DESCRIPTION="Open-source, model-agnostic terminal AI coding agent (any cloud provider or local Ollama models)"
ASSISTANT_PROVIDER="OpenCode (anomalyco)"
