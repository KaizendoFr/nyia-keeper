# Nyia Keeper Codex Configuration

# === ASSISTANT IDENTITY ===
ASSISTANT_NAME="codex"
ASSISTANT_CLI="codex"

# === DOCKER CONFIGURATION ===
BASE_IMAGE_NAME="nyiakeeper-codex"
DOCKERFILE_PATH="docker/codex"

# === DEV IMAGE SETTINGS ===
ALLOW_DEV_IMAGES="true"

# === PROJECT CONTEXT ===
CONTEXT_DIR_NAME=".nyiakeeper/codex"
CONFIG_DIR_NAME=".nyiakeeper/codex"


# === AUTHENTICATION ===
AUTH_METHOD="chatgpt_signin"
API_KEY_ENV="OPENAI_API_KEY"

# === RAG SETTINGS ===
# Embedding model for codebase search (requires Ollama on host)
# Options: nomic-embed-text (768d, fast), mxbai-embed-large (1024d, accurate)
# To use: nyia-codex --rag
# Install model: ollama pull nomic-embed-text
NYIA_RAG_MODEL="nomic-embed-text"


# === DISPLAY METADATA (Plan 35 — shown by `nyia list`) ===
ASSISTANT_DISPLAY_NAME="Codex"
ASSISTANT_FULL_NAME="OpenAI Codex CLI"
ASSISTANT_DESCRIPTION="OpenAI's agentic coding CLI for the terminal, powered by OpenAI models"
ASSISTANT_PROVIDER="OpenAI"
