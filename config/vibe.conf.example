# Nyia Keeper Vibe Configuration

# === ASSISTANT IDENTITY ===
ASSISTANT_NAME="vibe"
ASSISTANT_CLI="vibe"

# === DOCKER CONFIGURATION ===
BASE_IMAGE_NAME="nyiakeeper-vibe"
DOCKERFILE_PATH="docker/vibe"

# === DEV IMAGE SETTINGS ===
ALLOW_DEV_IMAGES="true"

# === PROJECT CONTEXT ===
CONTEXT_DIR_NAME=".nyiakeeper/vibe"
CONFIG_DIR_NAME=".nyiakeeper/vibe"


# === AUTHENTICATION ===
AUTH_METHOD="api_key"
API_KEY_ENV="MISTRAL_API_KEY"

# Your Mistral API key (will be prompted on first run if not set)
# Get your key at: https://console.mistral.ai/api-keys
# Uncomment and set your key, or let nyia-vibe prompt you on first run
#MISTRAL_API_KEY=""

# === RAG SETTINGS ===
# Embedding model for codebase search (requires Ollama on host)
# Options: nomic-embed-text (768d, fast), mxbai-embed-large (1024d, accurate)
# To use: nyia-vibe --rag
# Install model: ollama pull nomic-embed-text
NYIA_RAG_MODEL="nomic-embed-text"


# === DISPLAY METADATA (Plan 35 — shown by `nyia list`) ===
ASSISTANT_DISPLAY_NAME="Vibe"
ASSISTANT_FULL_NAME="Mistral Vibe"
ASSISTANT_DESCRIPTION="Mistral AI's coding assistant CLI, powered by Mistral models"
ASSISTANT_PROVIDER="Mistral AI"
